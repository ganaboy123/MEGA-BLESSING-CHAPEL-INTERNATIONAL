{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sermons Data",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "pastor",
      "date",
      "category",
      "summary",
      "thumbnail",
      "audio",
      "duration"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^srm-[0-9]{3}$"
      },
      "title": {
        "type": "string",
        "minLength": 3
      },
      "pastor": {
        "type": "string",
        "minLength": 3
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "category": {
        "type": "string",
        "minLength": 3
      },
      "summary": {
        "type": "string",
        "minLength": 12
      },
      "thumbnail": {
        "type": "string",
        "pattern": "^https?://"
      },
      "audio": {
        "type": "string",
        "pattern": "^https?://"
      },
      "duration": {
        "type": "string",
        "pattern": "^\\d{2}:\\d{2}$"
      }
    }
  }
}
